# Toast Analytics API Configuration
# Copy this file to .env and fill in your values

# Toast Analytics base URL, including /era/v1
# Usually: https://ws-api.toasttab.com/era/v1
TOAST_API_BASE_URL=https://ws-api.toasttab.com/era/v1

# OAuth2 Credentials for Toast Analytics API
# You need credentials with 'enterprise-metrics:read' scope
# Get these from your Toast API administrator
TOAST_API_CLIENT_ID=your_client_id_here
TOAST_API_CLIENT_SECRET=your_client_secret_here

# Alternative: You can also use a direct bearer token instead of OAuth2
# TOAST_API_TOKEN=your_bearer_token_here

# Note: Use the Analytics API credentials, not the Standard API credentials
# The Analytics API credentials should have 'enterprise-metrics:read' scope

# Optional: prioritize a specific restaurant when building menu tag mappings
# Useful when items exist on one location's menu but not others.
# Set either external ID (e.g., 9998) or a substring of the location name.
# TOAST_MENU_TAGS_PRIORITY_EXTERNAL_ID=9998
# TOAST_MENU_TAGS_PRIORITY_NAME=Summerville

# ------------------------------
# Aloha SQL Server Configuration
# ------------------------------
# Enable direct SQL Server ingestion for historical Aloha data.
# These are used by the SQL importer and API endpoints.

# SQL Server connection settings
ALOHA_SQL_SERVER=sql-prod
ALOHA_SQL_DATABASE=dev_aloha
ALOHA_SQL_USERNAME=your_username
ALOHA_SQL_PASSWORD=your_password

# Optional: Windows/Integrated auth (set to true to use trusted connection)
ALOHA_SQL_TRUSTED_CONNECTION=true

# Optional: ODBC driver name (Windows default shown below)
ALOHA_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Toast Puller — target database for writing hstCheck/hstItem
# Uses the same server as ALOHA_SQL_SERVER but targets the 'toast' database
TOAST_SQL_DATABASE=toast

# SQL query template. Must return Item, Quantity, Sales, BusinessDate columns.
# Use {start_date} and {end_date} placeholders (YYYY-MM-DD) for filtering.
# Optional: include Location (or Store, etc.) and OrderMode for per-location/per-channel breakdown.
# If your table has only FKOrderModeId, the importer will use it as OrderMode (numeric ID as string).
# To get order mode names instead, JOIN to the OrderMode lookup table, e.g.:
#   SELECT m.Item, m.Quantity, m.Sales, m.DateOfBusiness AS BusinessDate,
#          om.PrintName AS OrderMode
#   FROM dbo.MenuMix m
#   LEFT JOIN dbo.OrderMode om ON om.Id = m.FKOrderModeId
#   WHERE m.DateOfBusiness >= '{start_date}' AND m.DateOfBusiness <= '{end_date}'
ALOHA_SQL_QUERY=SELECT Item, Quantity, Sales, BusinessDate FROM AlohaSales WHERE BusinessDate >= '{start_date}' AND BusinessDate <= '{end_date}'

# ------------------------------
# OLO Ordering API (Order Export / Digital Orders by Platform)
# ------------------------------
# Use your OLO Client ID and Client Secret (Signature/Order Export credentials).
# Production is used by default; omit OLO_ORDERING_BASE_URL unless you need sandbox.
# OLO_CLIENT_ID=your_olo_client_id
# OLO_CLIENT_SECRET=your_olo_client_secret
# Optional (defaults to production): OLO_ORDERING_BASE_URL=https://ordering.api.olo.com/v1.1

# ------------------------------
# Email Invitations (Gmail SMTP)
# ------------------------------
# Used to send account invitation emails to new users.
# You must use a Gmail App Password (not your regular password).
# To create one: Google Account > Security > 2-Step Verification > App passwords
GMAIL_ADDRESS=reports@newks.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Base URL for invite links (no trailing slash)
APP_BASE_URL=http://localhost:8000

# ------------------------------
# Past-day sales reconciliation (nightly_orders_cache_job)
# ------------------------------
# The nightly job re-pulls the last RECONCILE_WINDOW_DAYS days of orders to
# catch amendments (voided checks, late item adds, retroactive discounts)
# made by restaurants AFTER our previous pull. If a (store, date) aggregate
# changed by more than the configured thresholds, a summary email fires.

# How many days back to re-pull each night (default 7).
RECONCILE_WINDOW_DAYS=7

# Net-sales absolute-dollar change that triggers an alert (default $50).
RECONCILE_NET_SALES_THRESHOLD_USD=50

# Check-count or voided-check-count change that triggers an alert (default 2).
RECONCILE_CHECK_COUNT_THRESHOLD=2

# Comma-separated list of email recipients for the alert summary.
# Leave blank to log changes without emailing.
RECONCILE_ALERT_RECIPIENTS=kaylesworth@newks.com

# ------------------------------
# Sysco sFTP puller (sysco_ftp.py)
# ------------------------------
# Only needed on the dev-jan02 deploy — Cloudways doesn't run this.
# See backend/sysco_ftp_deploy.md for full setup.

SYSCO_SFTP_HOST=sb2b.sysco.com
SYSCO_SFTP_USER=NEWKSEAT
SYSCO_SFTP_PASSWORD=get_from_keepass

# Sysco remote folders — change only if Sysco moves them
SYSCO_REMOTE_INBOX=/Outbound/
SYSCO_REMOTE_ARCHIVE=/Outbound/Archive/

# Local destinations on dev-jan02. The /mnt/newks-sql/ paths are SMB-mounted
# to the Windows shares the CDP Service watches — see deploy doc for fstab setup.
SYSCO_INVOICES_TEMP=/var/sysco/invoices_staging
SYSCO_INVOICES_DEST=/mnt/newks-sql/CDP_Service/upload/
SYSCO_INVOICES_NOT_ON_CT_DEST=/mnt/newks-sql/cdp_temp/Sysco/NotOnCT/
SYSCO_POS_DEST=/mnt/newks-sql/cdp_service/Sysco_PO_Archive/

# Log dir + alert recipient. Failure alerts use GMAIL_* above.
SYSCO_LOG_DIR=/var/log/sysco_ftp
SYSCO_ALERT_TO=kaylesworth@newks.com

# ------------------------------
# Contacts section (replaces forms.nfc.local PHP CRUD)
# ------------------------------
# Cloudways can't reach the internal sql-prod host, so we keep a local
# SQLite mirror of the contacts data instead of talking to SQL Server
# directly. Initial population done by running
# backend/contacts_export_from_sqlserver.py on dev-jan02 (which IS on
# the internal Newks network) and SCPing the resulting file here.

# Path to the SQLite mirror. Defaults to backend/data/contacts/contacts.db.
# Override if you want it elsewhere on disk.
# CONTACTS_SQLITE_PATH=/var/lib/newks/contacts.db

# Used by contacts_export_from_sqlserver.py — only set these on whatever
# box you run the exporter from (NOT on Cloudways).
# CONTACTS_SOURCE_HOST=sql-prod.nfc.local
# CONTACTS_SOURCE_USER=reports
# CONTACTS_SOURCE_PASSWORD=get_from_keepass
# CONTACTS_SOURCE_DRIVER=ODBC Driver 17 for SQL Server

# Sync-back outbox to SQL Server. When ON, every contacts edit (Store,
# AreaDir, Company, lookup tables, etc.) is captured in contacts_outbox
# so the dev-jan02 drainer cron can replay it against SQL Server hourly.
# Default OFF — turn ON only once the drainer (Phase 2) is deployed.
# CONTACTS_OUTBOX_ENABLED=1